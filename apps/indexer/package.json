{
  "name": "@railforge/indexer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --env-file=../../.env run --hot src/index.ts",
    "build": "echo 'no build step (Bun runs .ts directly)'",
    "start": "bun run src/index.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@railforge/db": "workspace:*",
    "@railforge/jobs": "workspace:*",
    "@railforge/logger": "workspace:*",
    "@railforge/xrpl-core": "workspace:*",
    "ioredis": "^5.10.1",
    "pino": "^9.5.0",
    "xrpl": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
