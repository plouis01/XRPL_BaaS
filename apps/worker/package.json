    "@railforge/xrpl-core": "workspace:*",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.1",
    "pino": "^9.5.0",
    "xrpl": "^4.6.0"
  },
  "devDependencies": {
    "@types/ioredis-mock": "^8.2.7",
    "@types/node": "^22.9.0",
    "ioredis-mock": "^8.13.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
