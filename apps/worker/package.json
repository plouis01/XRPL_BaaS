{
  "name": "@railforge/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "echo 'no build step (Bun runs .ts directly)'",
