# RailForge environment variables
# Copy to .env and fill in. Never commit .env — the secret-scan hook will block it.

# ── XRPL ─────────────────────────────────────────────────────────────────────
XRPL_NETWORK=testnet                                  # testnet | mainnet
XRPL_WS_URL=wss://s.altnet.rippletest.net:51233
XRPL_NODE_URL=https://s.altnet.rippletest.net:51234

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://railforge:dev-password@localhost:5432/railforge

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── HSM ──────────────────────────────────────────────────────────────────────
HSM_PROVIDER=softhsm                                  # softhsm | aws_cloudhsm
HSM_SLOT=0
HSM_PIN=changeme

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=3000
API_KEY_SALT=replace-with-random-32-bytes

# ── Treasury (testnet only — never set for mainnet in this file) ─────────────
TREASURY_SEED=
TREASURY_ADDRESS=

# ── Webhooks ─────────────────────────────────────────────────────────────────
WEBHOOK_SIGNING_SECRET=whsec_replace_me

# ── Mainnet safety ───────────────────────────────────────────────────────────
# Required to override the Claude Code mainnet-block hook on a per-command basis.
# Do NOT set this in .env — it must be passed inline on the command line.
# Example: RAILFORGE_ALLOW_MAINNET=1 bunx tsx scripts/mainnet-deploy.ts
# RAILFORGE_ALLOW_MAINNET=
