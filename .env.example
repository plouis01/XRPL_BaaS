# RailForge environment variables
# Copy to .env and fill in. Never commit .env — the secret-scan hook will block it.

# ── XRPL ─────────────────────────────────────────────────────────────────────
XRPL_NETWORK=testnet                                  # testnet | mainnet
XRPL_WS_URL=wss://s.altnet.rippletest.net:51233
XRPL_NODE_URL=https://s.altnet.rippletest.net:51234

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://railforge:dev-password@localhost:5432/railforge

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── HSM ──────────────────────────────────────────────────────────────────────
HSM_PROVIDER=softhsm                                  # softhsm | aws_cloudhsm
HSM_SLOT=0
HSM_PIN=changeme

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=3000
# REQUIRED. Server-side pepper used to HMAC-SHA256 every API key before lookup.
# Generate with: openssl rand -hex 32
# A missing salt makes auth fail-fast at the first request — boot loudly,
# don't skip this line.
API_KEY_SALT=replace-with-random-32-bytes
# Pre-auth IP rate limit (requests/minute per source IP). Optional — defaults
# to 300. This is the brute-force defense; tighten for higher-risk environments.
IP_RATE_LIMIT=300
# Comma-separated list of trusted proxy IPs (REVIEW.md M-1). When set, the
# API honors CF-Connecting-IP / X-Forwarded-For ONLY from these direct peers
# — anyone connecting directly has their forwarded-IP headers ignored so
# they can't rotate their apparent IP. Unset in dev (falls back to legacy
# trust-all behavior); MUST be set in prod to the IPs of your front-door
# proxy (Cloudflare IPs, an ALB's internal IP, etc.).
TRUSTED_PROXY_IPS=

# ── Treasury (testnet only — never set for mainnet in this file) ─────────────
TREASURY_SEED=
TREASURY_ADDRESS=

# ── Webhooks ─────────────────────────────────────────────────────────────────
WEBHOOK_SIGNING_SECRET=whsec_replace_me

# ── Mainnet safety ───────────────────────────────────────────────────────────
# Required to override the Claude Code mainnet-block hook on a per-command basis.
# Do NOT set this in .env — it must be passed inline on the command line.
# Example: RAILFORGE_ALLOW_MAINNET=1 bunx tsx scripts/mainnet-deploy.ts
# RAILFORGE_ALLOW_MAINNET=

# ── Public signup (testnet beta) ─────────────────────────────────────────────
# Opt-in flag for the /v1/dashboard/signup route in production. Defaults to
# off — the route is only registered in non-production unless this is set.
# Set to "1" on a testnet beta / early-access API to let anyone with the
# dashboard URL mint a testnet API key. The route mints rf_test_ keys ONLY
# (mainnet provisioning still goes through manual paths). Pre-auth IP rate
# limit applies. Do NOT enable on a mainnet API without first adding email
# verification + captcha — see apps/api/src/routes/dashboardSignup.ts.
# RAILFORGE_ALLOW_SIGNUP=1
