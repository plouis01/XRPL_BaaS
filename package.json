{
  "name": "railforge",
  "version": "0.0.0",
  "private": true,
  "description": "RailForge — XRPL Banking-as-a-Service platform. See ARCHITECTURE.md, PLAN.md, SETUP.md.",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:integration": "turbo test:integration",
    "typecheck": "turbo typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "cd packages/db && bunx drizzle-kit generate",
    "db:migrate": "cd packages/db && bunx drizzle-kit migrate",
    "db:studio": "cd packages/db && bunx drizzle-kit studio",
    "test:load": "k6 run scripts/k6/load-test.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.3.11",
    "@types/node": "^22.9.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  },
  "packageManager": "bun@1.1.38",
  "engines": {
    "node": ">=22"
  }
}
