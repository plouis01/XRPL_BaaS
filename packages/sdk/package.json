{
  "name": "@railforge/sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "TypeScript client SDK for the RailForge API — Stripe for XRPL",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --outDir dist",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "keywords": ["xrpl", "railforge", "blockchain", "api", "sdk", "fintech"],
  "repository": {
    "type": "git",
    "url": "https://github.com/plouis01/XRPL_BaaS"
  }
}
