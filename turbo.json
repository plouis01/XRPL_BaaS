{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", "tsconfig.base.json", "biome.json"],
  "globalEnv": [
    "NODE_ENV",
    "XRPL_NETWORK",
    "XRPL_WS_URL",
    "DATABASE_URL",
    "REDIS_URL",
    "RAILFORGE_ALLOW_MAINNET",
    "API_KEY_SALT",
    "IP_RATE_LIMIT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "outputs": []
    },
    "test:integration": {
      "cache": false,
      "env": ["XRPL_NETWORK", "XRPL_WS_URL", "DATABASE_URL", "REDIS_URL"]
    },
    "typecheck": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    }
  }
}
